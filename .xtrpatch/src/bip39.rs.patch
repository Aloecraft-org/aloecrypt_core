pub fn to_bip39(data: &[u8]) -> BIP39Encoded {
    // Trust the caller right now for simplicity
    assert!(data.len() % 4 == 0);
    let len = (3 * data.len() / 4) as u8;
    let mut buf = [0u16;255];

    let hash = Sha256::digest(data);
    for i in 0..len as usize {
        let mut index = 0u16;
        for j in 0..11 {
            let bit_pos = i * 11 + j;
            let bit = if bit_pos < data.len() * 8 {
                (data[bit_pos / 8] >> (7 - (bit_pos % 8))) & 1
            } else {
                let cs_pos = bit_pos - data.len() * 8;
                (hash[cs_pos / 8] >> (7 - (cs_pos % 8))) & 1
            };
            index = (index << 1) | (bit as u16);
        }
        buf[i] = index;
    }
    BIP39Encoded{len, buf}
}
