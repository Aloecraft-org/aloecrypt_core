fn main() {
    let mut rng = _make_rng();
    let mut seed = [0u8; 32];
    rng.fill_bytes(&mut seed);

    // 1. Setup the original secret
    let original_data = b"Keep it secret, keep it safe !";
    println!("Original: {:?}", String::from_utf8_lossy(original_data));
    println!("--------------------------------------------------");

    // 2. Encode bytes to 10-bit words (and append RS1024 checksum)
    let secret = to_slip39(original_data);

    // 3. Create 3-of-5 Shamir shares over GF(1024)
    let threshold = 3;
    let shares = create_5_slip39_shares(secret, threshold, seed);
    
    let mut recovery_subset = Vec::new();
    for (i, share) in shares.iter().enumerate() {

        #[cfg(feature = "slip39_words")]
        let mnemonic = to_slip39_mnemonic(share.secret.to_u16_arr());
        #[cfg(feature = "slip39_words")]
        println!("Share {} (Loc {}): {}", i + 1, share.location, mnemonic.to_str());
        
        #[cfg(not(feature = "slip39_words"))]
        println!("Enable feature `slip39_words` to print mnemonic");
    
        // Intentionally keep only 3 shares (indexes 0, 2, and 4)
        if i % 2 == 0 {
            recovery_subset.push(share.clone());
        }
    }
    println!("--------------------------------------------------");

    // 4. Test Recovery with exactly the threshold (3 shares)
    println!("Attempting recovery with 3 shares...");
    let recovered_secret = combine_slip39_shares(&recovery_subset);
    
    // 5. Decode 10-bit words back to 8-bit bytes (and verify checksum)
    let decoded = from_slip39(recovered_secret.to_u16_arr());
    
    let recovered_len = decoded.value[0] as usize;
    let recovered_bytes = &decoded.value[1..1 + recovered_len];
    
    println!("Recovered: {:?}", String::from_utf8_lossy(recovered_bytes));
    
    if recovered_bytes == original_data {
        println!("SUCCESS: Secret reconstructed perfectly!");
    } else {
        println!("FAILURE: Reconstruction failed.");
    }
}
