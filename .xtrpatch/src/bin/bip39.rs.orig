use aloecrypt_core::aloecrypt_api::*;
use aloecrypt_core::fixed_byte::*;
use aloecrypt_core::bip39::*;
use aloecrypt_core::rng_api::*;
use aloecrypt_core::rng::*;

use rand_core::{Rng, RngCore};
fn _make_rng() -> impl CryptoRngCore {
    let mut seed = [0u8; 32];
    getrandom::getrandom(&mut seed);
    AloeRng::new(seed)
}

fn main() {
    let mut original = [0u8; 16];
    let mut rng = _make_rng();
    rng.fill_bytes(&mut original);

    let encoded = to_bip39(&original);
    
    #[cfg(feature = "bip39_words")]
    let mnemonic = to_bip39_mnemonic(&encoded.buf[..encoded.len as usize]);

    #[cfg(feature = "bip39_words")]
    println!("Mnemonic: {}", mnemonic.to_str());

    #[cfg(not(feature = "bip39_words"))]
    println!("Enable feature `bip39_words` to print mnemonic");
    
    let decoded = from_bip39(&encoded.buf[..encoded.len as usize]);
    assert_eq!(&decoded.value[1..1 + original.len()], &original);
    println!("Hex: {:02x?}", &decoded.value[1..1 + original.len()]);
}