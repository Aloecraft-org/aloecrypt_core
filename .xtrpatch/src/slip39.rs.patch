pub fn from_slip39_mnemonic(mnemonic: &VarString511) -> VarU16_255 {
    let mut arr = [0u16; 255];
    let mut len = 0;
    for word in mnemonic.to_str().split(' ') {
        if let Some(idx) = SLIP39_WORDLIST.iter().position(|&w| w == word) {
            arr[len] = idx as u16;
            len += 1;
        }
    }
    VarU16_255::from_u16_arr(&arr[..len])
}
