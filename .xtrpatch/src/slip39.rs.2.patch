<<<< 190:220
pub fn combine_slip39_shares(shares: &[SLIP39Secret]) -> VarU16_255 {
    let n = shares.len();
    let secret_len = shares[0].secret.value[0] as usize;
    let mut result = VarU16_255::empty();
    result.value[0] = secret_len as u8;

    for part_idx in 0..secret_len {
        let mut secret_part = 0u16;
        let offset = 2 + (part_idx * 2);
        
        for i in 0..n {
            let mut li = 1u16; // The Lagrange basis polynomial evaluated at x=0
            for j in 0..n {
                if i == j { continue; }
                
                let xi = shares[i].location;
                let xj = shares[j].location;

                // Formula for L_i(0): product of (xj / (xj XOR xi))
                let denominator = gf1024_add(xj, xi);
                let fraction = gf1024_mul(xj, gf1024_inv(denominator));
                li = gf1024_mul(li, fraction);
            }
            
            let yi = u16::from_le_bytes([shares[i].secret.value[offset], shares[i].secret.value[offset + 1]]);
            secret_part = gf1024_add(secret_part, gf1024_mul(yi, li));
        }
        result.value[offset..offset + 2].copy_from_slice(&secret_part.to_le_bytes());
    }
    result
}
