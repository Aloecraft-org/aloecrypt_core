    def emit_enums(self, enums: dict[str, MetaEnum]) -> list[str]:
        lines = []
        for e in enums.values():
            if e.description:
                lines.append(f"/** {e.description} */")
            lines.append(f"export enum {e.name} {{")
            for m in e.members:
                if m.description:
                    lines.append(f"  /** {m.description} */")
                lines.append(f"  {m.name} = {m.discriminant},")
            lines.append("}")
            lines.append("")
        return lines

